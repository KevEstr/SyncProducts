# ============================================================
#  Configuración - Sync Shopify
#  Copia este archivo como .env y completa los valores
# ============================================================

# Tienda Shopify (sin https://)
SHOPIFY_STORE=kunqhm-km.myshopify.com

# Credenciales OAuth de Shopify (para obtener token temporal)
SHOPIFY_CLIENT_ID=tu_client_id_aqui
SHOPIFY_CLIENT_SECRET=tu_client_secret_aqui

# URL completa de la API de inventario (incluye api_key)
API_URL=http://186.97.200.50:8090/api/inventario?api_key=TU_API_KEY_AQUI

# Límite de productos a sincronizar para pruebas.
# 0 = sincronizar todos
# 3 = sincronizar solo 3 productos
SYNC_LIMIT=3

# Horario de ejecución diaria (formato 24h: HH:MM)
# Por defecto: 23:59 (11:59 PM)
SYNC_HORA=23:59

# Puerto del servidor de monitoreo HTTP
# Acceder desde otro PC: http://[IP-SERVIDOR]:5001/status
# Endpoints disponibles:
#   /status  → resumen de la última sincronización
#   /logs    → últimas 500 líneas del log producto por producto
#   /health  → estado del servicio
MONITOR_PORT=8091

# ── Cloudflare R2 (almacenamiento de logs) ────────────────────
# El log de cada sincronización se sube a R2 sobreescribiendo
# el mismo objeto, para que siempre tengas el más reciente.
#
# Cómo obtener estos valores:
#   1. Workers & Pages → R2 → tu bucket → Settings
#   2. Account ID: esquina superior derecha del dashboard
#   3. Access Key ID / Secret: R2 → Manage R2 API Tokens
#
# URL pública (opcional): si configuraste un dominio o acceso público
# en el bucket, pégalo aquí para verlo directo desde el browser.
CF_R2_ACCOUNT_ID=bd9123fa0a487d4429430199ce2073df
CF_R2_ACCESS_KEY_ID=66fc8d82db20ce9120d2d73828da0dc7
CF_R2_SECRET_ACCESS_KEY=ef4215ecf89c933c3636578561cca0515d62c8ec273264ba03af7ad33804a84e
CF_R2_BUCKET_NAME=centrojapon
CF_R2_OBJECT_KEY=sync.log
CF_R2_PUBLIC_URL=https://pub-8065b9339cf14de08c91abfe84445769.r2.dev
